# =====================================================
# PERROSYGATOS - ENVIRONMENT VARIABLES
# =====================================================

# =====================================================
# APPLICATION NAMES
# =====================================================
SPRING_APPLICATION_NAME_AUTH=pyg-auth
SPRING_APPLICATION_NAME_OWNER=pyg-owner
SPRING_APPLICATION_NAME_PROFESSIONAL=pyg-professional

# =====================================================
# SERVER PORTS
# =====================================================
SERVER_PORT_GATEWAY=9090

SERVER_PORT_AUTH=8081
SERVER_PORT_OWNER=8082
SERVER_PORT_PROFESSIONAL=8083

# =====================================================
# DATABASE CONFIG
# =====================================================
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# =====================================================
# POSTGRES DATABASES
# Docker host should be: postgres
# Localhost should be used only outside Docker
# =====================================================
POSTGRES_DB=perrosygatos

AUTH_DATABASE_URL=jdbc:postgresql://postgres:5432/pyg_auth
OWNER_DATABASE_URL=jdbc:postgresql://postgres:5432/pyg_owner
PROFESSIONAL_DATABASE_URL=jdbc:postgresql://postgres:5432/pyg_professional

# =====================================================
# JPA / HIBERNATE CONFIG
# =====================================================
SPRING_JPA_HIBERNATE_DDL_AUTO=update

SPRING_JPA_SHOW_SQL=false
SPRING_JPA_OPEN_IN_VIEW=false

SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

SPRING_JPA_PROPERTIES_FORMAT_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# =====================================================
# JWT CONFIG
# =====================================================
JWT_SECRET=change_me_to_a_strong_secret

# 15 minutes
JWT_EXPIRATION=900000

# 7 days
JWT_REFRESH_EXPIRATION=604800000

# =====================================================
# INTERNAL MICROSERVICE URLS
# Docker network service names
# =====================================================
AUTH_SERVICE_URL=http://pyg-auth:8081
OWNER_SERVICE_URL=http://pyg-owner:8082
PROFESSIONAL_SERVICE_URL=http://pyg-professional:8083

# =====================================================
# FEIGN CLIENT CONFIG
# =====================================================
FEIGN_CONNECT_TIMEOUT=5000
FEIGN_READ_TIMEOUT=5000

# =====================================================
# LOGGING CONFIG
# =====================================================
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
SPRING_LOG_LEVEL=INFO

HIBERNATE_SQL_LOG_LEVEL=DEBUG
HIBERNATE_BINDER_LOG_LEVEL=TRACE

# =====================================================
# FUTURE SERVICES
# =====================================================
BEHAVIOR-CASE-PORT=3001
NOTIFICATION_PORT=3002
CONTENT_PORT=3003